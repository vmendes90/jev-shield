{
  "manifest_version": 3,
  "name": "Jev Shield - AI Native Ad Blocker",
  "version": "0.1.0",
  "description": "Block native ads, sponsored posts, and stealth promotions semantically using TypeSafe's Jev model.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules/ad_rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Jev Shield"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
